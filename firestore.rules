rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Secure Reviews ---
    // Anyone can read active reviews
    // Only the Backend API (Admin SDK) can write reviews
    match /reviews/{review} {
      allow read: if true;
      allow write: if false; 
    }
    
    // --- Secure Proofs ---
    // Anyone can read active proofs
    // Only Admins can write
    match /proofs/{proof} {
      allow read: if true;
      // If we implement admin custom claims in the future:
      // allow write: if request.auth != null && request.auth.token.admin == true;
      // For now, since writes happen from the protected backend /admin routes, we can just block client writes:
      allow write: if false;
    }
    
    // --- Secure Payments ---
    match /payments/{payment} {
      allow read: if true;
      allow write: if false;
    }

    // Default block
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
